{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/tabscroll-16.png",
      "32": "icons/tabscroll-32.png",
      "48": "icons/tabscroll-48.png"
    },
    "default_title": "__MSG_openTabScroll__"
  },
  "commands": {
    "toggle-tabscroll": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "__MSG_openTabScroll__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/tabscroll-16.png",
    "32": "icons/tabscroll-32.png",
    "48": "icons/tabscroll-48.png",
    "128": "icons/tabscroll-128.png"
  }
}
